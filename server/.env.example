PORT=3000
JWT_SECRET=change-me-in-production
DB_PATH=./data/rokdim300.db
CLIENT_ORIGIN=https://localhost:5173
APP_URL=https://localhost:5173
# Local dev uses HTTPS when certificates exist; set HTTPS=false behind an HTTPS reverse proxy.
# HTTPS=false
# Optional: override HTTPS certificate paths
# HTTPS_KEY_PATH=../.certs/localhost-key.pem
# HTTPS_CERT_PATH=../.certs/localhost-cert.pem

# Optional: SMTP for password reset emails (if not set, reset link is returned in API response for dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=רוקדים 300 <noreply@rokdim300.co.il>
